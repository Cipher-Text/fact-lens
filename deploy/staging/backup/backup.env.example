# Copy to deploy/staging/backup/backup.env (gitignored). Keep this file and the passphrase file on the host only.
# Cloudflare R2 (S3 API). Use a bucket used only for backups, and a key that can only write and read it.
BACKUP_BUCKET=factlens-staging-backups
BACKUP_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
# A file holding the encryption passphrase (mode 600). Store a second copy offline: without it, no backup can be read.
BACKUP_PASSPHRASE_FILE=/root/factlens-backup.pass
# Optional: the postgres container, if `docker compose ps -q postgres` is not what you want.
# BACKUP_POSTGRES_CONTAINER=
