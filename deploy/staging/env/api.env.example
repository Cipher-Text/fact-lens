NODE_ENV=production
DATABASE_URL=postgres://factlens:CHANGE_ME@postgres:5432/factlens
REDIS_URL=redis://redis:6379
# Generate with: docker run --rm factlens-api:staging node dist/auth/keygen.js (see the runbook). Keep them secret.
AUTH_SIGNING_KEY=
AUTH_ENCRYPTION_KEY=
# The API is not published; this names it in the tokens. The newsroom's public address:
AUTH_ISSUER=https://api.internal.example
NEWSROOM_BASE_URL=https://newsroom.example.org
# At least 32 characters, the same value as in worker.env.
INTERNAL_API_TOKEN=
# Media in Cloudflare R2 (S3 API). Set the endpoint of your account.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# One proxy (the site or the newsroom reaches the API), so the reader's address comes from X-Forwarded-For.
TRUST_PROXY=true
PUBLIC_SITE_HOSTS=www.example.org
# At least 32 characters.
POLL_HASH_SECRET=
# Optional: the newsroom's writing suggestions. Blank turns them off.
GEMINI_API_KEY=
