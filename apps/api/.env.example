NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgres://factlens:factlens@localhost:5432/factlens
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# OIDC. Leave unset in development to make every protected route return 401.
# OIDC_ISSUER=https://idp.example.com/
# OIDC_AUDIENCE=fact-lens-api
# OIDC_JWKS_URI=https://idp.example.com/.well-known/jwks.json
OIDC_ROLES_CLAIM=roles
OIDC_REQUIRE_MFA=false

# Shared secret for the worker's /internal calls (32+ chars). Unset disables /internal.
# INTERNAL_API_TOKEN=
