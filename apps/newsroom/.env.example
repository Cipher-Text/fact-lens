# Public origin of this app (OIDC redirect URI is NEWSROOM_BASE_URL/auth/callback).
NEWSROOM_BASE_URL=http://localhost:3100
# The API, reached from the server only.
API_BASE_URL=http://localhost:4000
# Local development uses the dev identity provider: `pnpm dev:idp`.
OIDC_ISSUER=http://127.0.0.1:4300
OIDC_CLIENT_ID=newsroom
# OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile
# Random, 32+ characters, different in every environment. Generate: openssl rand -base64 48
SESSION_SECRET=
