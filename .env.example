# Fact Lens local development settings. ONE file for the whole repository.
#
#   pnpm env:init      copies this file to .env and fills in the two secrets below
#
# The API, the worker, the newsroom and the dev identity provider all read the root .env.
# Each app uses only its own variables (marked below) and ignores the rest.
# For development only. Real deployments give each service just its own variables through the
# platform's secret store, never this file: the newsroom must not hold the database password.
# Never commit .env (it is ignored by git).

# ---------------------------------------------------------------- shared
NODE_ENV=development
# api, worker
LOG_LEVEL=info
# api, worker, migrations, seed
DATABASE_URL=postgres://factlens:factlens@localhost:5432/factlens
# api, worker
REDIS_URL=redis://localhost:6379
# api and worker. They must match (32+ characters). `pnpm env:init` generates one.
INTERNAL_API_TOKEN=
# worker, newsroom: where they reach the API. Keep it in step with API_PORT.
API_BASE_URL=http://localhost:4000
# api, newsroom: the OpenID Connect provider. These point at the local dev provider (`pnpm dev:idp`).
OIDC_ISSUER=http://127.0.0.1:4300

# ---------------------------------------------------------------- api
API_HOST=127.0.0.1
API_PORT=4000
OIDC_AUDIENCE=fact-lens-api
OIDC_JWKS_URI=http://127.0.0.1:4300/jwks.json
OIDC_ROLES_CLAIM=roles
# Privileged actions (publish, correct, audit, ads, configuration) need a second-factor sign-in.
OIDC_REQUIRE_MFA=true
# Media storage. `fs` keeps files in a local folder (development only); `s3` is any S3-compatible
# store (Cloudflare R2, MinIO). Production must use s3.
STORAGE_DRIVER=fs
FS_STORAGE_DIR=.data/media
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=factlens-media
# S3_ACCESS_KEY_ID=factlens
# S3_SECRET_ACCESS_KEY=factlens-local
# S3_FORCE_PATH_STYLE=true
MAX_UPLOAD_MB=10

# api: writing suggestions (headline, standfirst, slug, SEO text) from the news text, using Gemini.
# Leave the key empty to turn the "Generate with Gemini" button off. The key stays on the server.
# Get one at https://aistudio.google.com/apikey. The news text is sent to Google when the button is used.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------- worker
WORKER_HEALTH_PORT=4100
# OUTBOX_POLL_MS=1000
# SCHEDULE_SCAN_MS=30000
# JOB_CONCURRENCY=5

# ---------------------------------------------------------------- newsroom
# The public address of the newsroom. The sign-in redirect is NEWSROOM_BASE_URL/auth/callback.
NEWSROOM_BASE_URL=http://localhost:3100
OIDC_CLIENT_ID=newsroom
# OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile
# Encrypts the session cookie (32+ characters). `pnpm env:init` generates one.
SESSION_SECRET=

# ---------------------------------------------------------------- dev identity provider (tools/dev-idp)
DEV_IDP_PORT=4300
DEV_IDP_REDIRECT_URIS=http://localhost:3100/auth/callback
DEV_IDP_CLIENT_ID=newsroom

# Test settings (TEST_DATABASE_URL, TEST_REDIS_URL, TEST_S3_*) are not read from this file.
# Pass them in the shell when you run the tests: see the README.

# ---------------------------------------------------------------- web
# web: the public site's header menu reads the API at this address (for example http://localhost:4000).
# Unset keeps the static mock menu. apps/web does not read the root .env: set this in the shell or in apps/web/.env.local.
# FACTLENS_API_URL=
