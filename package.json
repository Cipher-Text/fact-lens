{
  "name": "fact-lens",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter fact-lens-web dev",
    "dev:web": "pnpm --filter fact-lens-web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev:api": "pnpm --filter @fact-lens/api dev",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml down",
    "dev:worker": "pnpm --filter @fact-lens/worker dev",
    "dev:newsroom": "pnpm --filter @fact-lens/newsroom dev",
    "dev:idp": "pnpm --filter @fact-lens/dev-idp start"
  }
}
